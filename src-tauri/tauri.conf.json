{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "agent-state-indicator",
  "mainBinaryName": "asi",
  "version": "0.6.0",
  "identifier": "com.nanayonkyuu.test",
  "build": {
    "beforeDevCommand": "npm run prepare:cli && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run prepare:cli && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "create": false,
        "visible": false,
        "width": 164,
        "height": 472,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "decorations": false,
        "transparent": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "nanayonkyuu",
    "homepage": "https://github.com/7749Y/agent-state-indicator",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/qwq"],
    "windows": {
      "nsis": {
        "languages": ["SimpChinese"],
        "installerIcon": "icons/nanayonkyuu.ico",
        "uninstallerIcon": "icons/uninstall.ico",
        "installerHooks": "installer/hooks.nsh"
      }
    }
  }
}
